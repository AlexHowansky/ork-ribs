# Copy to .env and uncomment the settings you want to change.
# Bun loads .env automatically. The values shown are the defaults.

# Where the server listens (port 1-65535). Use HOST=0.0.0.0 for all interfaces.
#PORT=3000
#HOST=127.0.0.1

# SQLite database file
#DB_PATH=data/ribs.sqlite

# debug, info, warn or error
#LOG_LEVEL=info

# How often to check the state's data for updates (1-720)
#SYNC_INTERVAL_HOURS=24

# Optional Socrata app token for higher API limits
# https://dev.socrata.com/docs/app-tokens.html
#SOCRATA_APP_TOKEN=

# Requests per minute per client IP on /api/* (10-100000)
#RATE_LIMIT_PER_MINUTE=240
